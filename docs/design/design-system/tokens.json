{
  "name": "Análise de Ações",
  "version": "1.0.0",
  "color": {
    "light": {
      "background": "#f7f8fa",
      "foreground": "#14171c",
      "surface": "#ffffff",
      "surface-2": "#eef0f3",
      "line": "#e2e5ea",
      "muted": "#5d6673",
      "text-positive": "#047857",
      "text-negative": "#c81e1e",
      "text-neutral": "#b45309"
    },
    "dark": {
      "background": "#0b0e13",
      "foreground": "#e8ebf0",
      "surface": "#12161d",
      "surface-2": "#1b2029",
      "line": "#232a35",
      "muted": "#8b95a5",
      "text-positive": "#34d399",
      "text-negative": "#f87171",
      "text-neutral": "#fbbf24"
    },
    "tone": {
      "strong-up": { "value": "#059669", "meaning": "Forte alta · Comprar · Operar" },
      "up": { "value": "#10b981", "meaning": "Alta · Manter" },
      "neutral": { "value": "#d97706", "meaning": "Lateral · Observar · Aguardar" },
      "down": { "value": "#dc2626", "meaning": "Baixa · Reduzir · Vender · Evitar" },
      "tone-bg-mix": "15%"
    },
    "chart": {
      "close": "#10b981",
      "ma5": "#38bdf8",
      "ma20": "#fbbf24",
      "sparkline-up": "#10b981",
      "sparkline-down": "#ef4444",
      "sparkline-area-opacity": 0.1
    },
    "primary-button": { "default": "#059669", "hover": "#10b981" },
    "focus-ring": "rgba(16, 185, 129, 0.2)"
  },
  "font": {
    "sans": "Geist",
    "mono": "Geist Mono",
    "numbers": "font-mono + tabular-nums"
  },
  "type": {
    "page-title": { "size": "24px", "weight": 600, "tracking": "-0.02em" },
    "ticker-detail": { "font": "mono", "size": "30px", "weight": 600 },
    "card-title": { "size": "14px", "weight": 600 },
    "label": { "size": "12px", "color": "muted" },
    "body-report": { "size": "14px", "line-height": 1.65, "white-space": "pre-line" },
    "kpi-value": { "font": "mono", "size": "26px", "weight": 600 }
  },
  "radius": { "card": "12px", "field": "8px", "tag": "6px", "pill": "999px" },
  "space": {
    "content-max": "1280px",
    "gutter": "16px",
    "page-y": "32px",
    "gap": "16px",
    "gap-kpi": "12px",
    "card-padding": "20px",
    "kpi-padding": "16px"
  },
  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" },
  "scoreTone": { ">70": "Forte alta", ">60": "Alta", "40-60": "Lateral", "<40": "Baixa" },
  "actionTone": {
    "buy": "Comprar", "add": "Comprar", "hold": "Manter", "watch": "Observar",
    "reduce": "Reduzir", "sell": "Vender", "avoid": "Evitar", "alert": "Alerta"
  }
}
